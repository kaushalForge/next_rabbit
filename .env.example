# ─────────────────────────────────────────────────────────────
# Rabbit e-commerce — Environment Variables
# Copy this file to ".env" and fill in the values below.
# (Next.js loads .env automatically; NEXT_PUBLIC_* vars are
#  exposed to the browser, the rest stay server-side.)
# ─────────────────────────────────────────────────────────────

# 1) SITE / API BASE URLS
# Same origin in this full-stack Next.js app (frontend + API together).
# Dev  → http://localhost:3000
# Prod → https://your-domain.com   (must be https in production so the
#        auth cookie is sent — see note in middleware/cookieOptions)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# 2) DATABASE (MongoDB Atlas)
# Get it from https://cloud.mongodb.com → Cluster → Connect →
# "Compass" or "Node.js driver" → copy the mongodb+srv://... string.
# Replace <password> with your DB user's password and append
# ?retryWrites=true&w=majority.
# Example: mongodb+srv://rabbit:MY_PASSWORD@cluster0.xxxxx.mongodb.net/rabbit?retryWrites=true&w=majority
URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/rabbit

# (Optional) Standalone DB password. NOT referenced by the code today
# because the full URI above already embeds the password. Keep in sync
# only if you switch to a templated connection string.
MONGODB_PASSWORD=

# 3) SERVER PORT
# (Optional) Port for `next dev` / `next start`. Defaults to 3000.
# Override with: next dev -p 4000   (currently unused by the code)
PORT=3000

# 4) AUTH JWT SECRET
# Random string used to sign/verify the login token.
# Generate one with either:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#   openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-string

# 5) CLOUDINARY (product image uploads)
# From https://cloudinary.com/console → Dashboard (API keys section).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 6) GOOGLE SIGN-IN (One Tap)
# From https://console.cloud.google.com → APIs & Services → Credentials
# → create an "OAuth 2.0 Client ID" of type "Web application".
# Add http://localhost:3000 (and your prod domain) to
# "Authorized JavaScript origins" and "Authorized redirect URIs".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# (Optional) Google OAuth client secret from the same credential.
# Not used by the current client-side One Tap flow; kept for
# server-side OAuth if you add it later.
GOOGLE_AUTH_CLIENT_SECRET=

# 7) EMAIL NOTIFICATIONS (order emails via Gmail/Nodemailer)
# The app sends from the fixed address "inbox.rabbit@gmail.com",
# so this must be the Gmail APP PASSWORD for that account
# (not your normal Gmail password).
# Create one at: Google Account → Security → 2-Step Verification →
# "App passwords" → generate a 16-char password, paste without spaces.
NEXT_PUBLIC_RABBIT_EMAIL_PASSWORD=

# (Optional) Session secret. Not referenced by the current code;
# safe to leave blank.
SESSION_SECRET=
